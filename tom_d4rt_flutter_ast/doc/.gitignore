# Test run log folders — large, machine-generated, not worth versioning.
# Only the hand-authored error_analysis.md / README.md files that live
# inside a testlog_* folder are tracked separately (see below).
testlog_*/**
!testlog_*/error_analysis.md
!testlog_*/README.md
!testlog_*/_baseline_id.txt
!testlog_*/_revision.txt
!testlog_*/_timestamp.txt
!testlog_*/_driver.log.txt
!testlog_*/framework_error_fix_plan.md
!testlog_*/over_budget_scripts.md
