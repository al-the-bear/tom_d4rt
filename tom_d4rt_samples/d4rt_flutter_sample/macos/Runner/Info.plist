<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!--
	  Opt out of Flutter's experimental merged platform/UI thread.

	  This app interprets Dart scripts into a live widget tree *synchronously*
	  on the UI thread (see SourceFlutterD4rt.buildProgram / build). With the
	  platform thread merged into the UI thread (the default since Flutter
	  3.29+), that synchronous work also blocks window/OS event handling — so a
	  sample that rebuilds interpreted code every animation frame (e.g.
	  clock_face once Play is pressed) starves the platform thread and the
	  window stops responding to input until the animation stops (it never
	  does), leaving "close" as the only option. Keeping the threads separate
	  lets the window stay responsive while the UI thread interprets.
	-->
	<key>FLTEnableMergedPlatformUIThread</key>
	<false/>
</dict>
</plist>
