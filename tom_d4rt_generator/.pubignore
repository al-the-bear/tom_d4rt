# Workspace temp scratch — never published.
ztmp/

# Tool output and build artifacts — regenerated by consumers, not shipped.
.dart_tool/
**/.dart_tool/
**/build/

# Compiled executables committed under example bin/ dirs (d4, d4.exe,
# d4_tester, d4_coverage, d4rtrun, d4rtrun.b ...). Keep only the source
# entry points so the examples remain readable on pub.dev.
example/**/bin/*
!example/**/bin/*.dart
!example/**/bin/*.yaml

# Test result artifacts, logs, and baselines — dev-only, large, not consumed.
**/*.result.json
**/test_results.*
**/last_testrun.json
**/all_tests.*
doc/testlog_*/
doc/baseline_*.csv

# Internal development records — step-0 reviews, refactoring/regression
# summaries, fix logs, coverage + issue trackers. index.md labels these
# "development-time records, not user documentation" (P5: not user-facing).
doc/step0_review_baseline.md
doc/mci_step0_review_baseline.md
doc/open_step0_review_baseline.md
doc/summary_refactoring_plan.md
doc/baseline_summary_refactor.md
doc/reexport_implementation_plan.md
doc/flutter_fixes_1.md
doc/flutter_fixes_2.md
doc/summary_phase7_regression.md
doc/test_coverage.md
doc/issues.md
