# Workspace temp scratch — never published.
ztmp/

# Compiled native REPL binary (rebuilt by tests / CI). .pubignore replaces the
# local .gitignore, which excluded this, so it must be re-declared here.
bin/dclie

# Tool output and build artifacts — regenerated by consumers, not shipped.
.dart_tool/
**/.dart_tool/
**/build/

# Compiled executables committed under example bin/ dirs (d4, d4.exe,
# d4_tester, d4_coverage, d4rtrun, d4rtrun.b ...). Keep only the source
# entry points so the examples remain readable on pub.dev.
example/**/bin/*
!example/**/bin/*.dart
!example/**/bin/*.yaml

# Test result artifacts, logs, and baselines — dev-only, large, not consumed.
**/*.result.json
**/test_results.*
**/last_testrun.json
**/all_tests.*
doc/testlog_*/
doc/baseline_*.csv

# Internal development docs — dated issue log + regen baseline (P5: not user-facing).
doc/issues_0215-0800.md
doc/regen_transcript_baseline_20260422.txt
